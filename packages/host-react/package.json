{
  "name": "@platform/host-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React bindings for a platform shell: PlatformProvider, host hooks, and the MfeOutlet/WidgetSlot mount lifecycle. Platform API, not shell UI — it ships no design system.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@platform/host": "workspace:*",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "@tanstack/react-router": "^1.170.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@platform/host": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "jsdom": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
