{
  "name": "@platform/host",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-free shell runtime: remote registry, runtime configuration, Module Federation loading, version-group dependency sharing, isolated mounting, overlay manager, telemetry, diagnostics, and the headless command, search and settings APIs a shell builds its own UI on.",
  "bin": {
    "platform-host-entrypoint": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./entrypoint": {
      "types": "./dist/entrypoint.d.ts",
      "default": "./dist/entrypoint.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin.js",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@module-federation/runtime": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@types/node": "catalog:",
    "@platform-internal/core": "workspace:*",
    "@platform-internal/module-federation": "workspace:*",
    "@platform-internal/diagnostics": "workspace:*"
  }
}
