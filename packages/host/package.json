{
  "name": "@platform/host",
  "version": "0.1.0",
  "type": "module",
  "description": "Shell-side runtime: remote registry, runtime configuration, Module Federation loading, version-group dependency sharing, isolated mounting, shell-backed history, command palette, settings host, help and release notes, breadcrumbs, overlay manager, telemetry, diagnostics and lazy developer tools.",
  "bin": {
    "platform-host-entrypoint": "./dist/entrypoint.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./entrypoint": {
      "types": "./dist/entrypoint.d.ts",
      "default": "./dist/entrypoint.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node ./scripts/build-harness.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@module-federation/runtime": "catalog:",
    "@xyflow/react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-router": "^1.170.0",
    "@tecton/react": "*",
    "react-aria-components": "^1.21.0",
    "lucide-react": "*",
    "cn": "*",
    "sonner": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tecton/react": "catalog:",
    "react-aria-components": "catalog:",
    "lucide-react": "catalog:",
    "cn": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "sonner": "catalog:",
    "next-themes": "catalog:",
    "class-variance-authority": "catalog:",
    "@tanstack/history": "catalog:",
    "@platform-internal/core": "workspace:*",
    "@platform-internal/module-federation": "workspace:*",
    "@platform-internal/diagnostics": "workspace:*",
    "@platform-internal/devtools": "workspace:*"
  }
}
