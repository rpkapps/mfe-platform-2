{
  "$id": "https://platform.docs.local/schemas/registrations.json",
  "title": "registrations",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shortcut": {
            "type": "string"
          },
          "permissionGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "type": "string"
          },
          "static": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "managedBy": {
            "default": "framework",
            "type": "string",
            "enum": [
              "framework",
              "mfe"
            ]
          },
          "route": {
            "type": "string"
          },
          "fields": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "boolean",
                    "text",
                    "number",
                    "select",
                    "multi-select",
                    "unknown"
                  ]
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "key"
              ]
            }
          }
        },
        "required": [
          "key",
          "title"
        ]
      }
    },
    "help": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          },
          "route": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "releaseNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "title"
        ]
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "propsSchema": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "permissionGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "required": [
    "commands",
    "settings",
    "help",
    "releaseNotes",
    "widgets"
  ]
}
